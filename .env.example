# The inbox owner. OAuth must authenticate as exactly this address.
GMAIL_ACCOUNT_EMAIL=YOUR_SOURCE_GMAIL_ADDRESS
DIGEST_RECIPIENT_EMAIL=YOUR_DIGEST_RECIPIENT_EMAIL
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
DATABASE_PATH=gmail_agent.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
DRY_RUN=true
LOG_LEVEL=INFO
LOCK_FILE=gmail_agent.lock
# Only inspect recent unread inbox mail, with a hard per-run cap.
GMAIL_LOOKBACK_DAYS=2
MAX_MESSAGES_PER_RUN=200
